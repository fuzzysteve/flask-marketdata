{% extends "base.phtml" %}       
{% block title %}{{typename}}{% endblock %}
{% block extrahead %}
{% if history %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uplot@1.6.32/dist/uPlot.min.css" integrity="sha384-IfV0B7MIOYuO95kO9G5ySKPz/85zqFNOAs8iy4tkK5zd9izhJAB8b7lHrwYqqmYE" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/uplot@1.6.32/dist/uPlot.iife.min.js" integrity="sha384-Gx3t0zdBAuQOuvvmaLZj7HKEiSgWTAs+VdtNY7wt19QDPTDQjFIwAuXDj0zeN00c" crossorigin="anonymous"></script>
<script src="/js/history.js" defer></script>
{% endif %}
{% endblock %}
{% block content %}
<div class="content">
<h1>{{typename}}</h1>
{% if history %}
<div class="pure-g">
<div class="pure-u-1">
<h2>Price History</h2>
{% if history|length > 1 %}
<label for="historylocation">Hub</label>
<select id="historylocation">
{% for location in history %}<option value="{{location.id}}">{{location.name}}</option>{% endfor %}
</select>
{% endif %}
<div class="historycontrols">
<span class="historyranges" role="group" aria-label="Time range">
<button type="button" data-days="7">1W</button><button type="button" data-days="30">1M</button><button type="button" data-days="90" class="active" aria-pressed="true">3M</button><button type="button" data-days="182">6M</button><button type="button" data-days="365">1Y</button><button type="button" data-days="0">All</button>
</span>
<label><input type="checkbox" id="historylog"> Log scale</label>
<label><input type="checkbox" id="historyvolume"> Volume on market</label>
<button type="button" id="historycsv">Download CSV</button>
</div>
<div id="pricehistory" class="pricehistory" data-type="{{type}}" data-location="{{history[0].id}}"></div>
<div id="historyvolumechart" class="pricehistory" hidden></div>
<p class="historyhint">Drag across the chart to zoom in, double-click to reset. Click a legend item to hide or show that line.</p>
</div>
</div>
{% endif %}
<div class="pure-g">
<div class="pure-u-1">
<a name="sell"></a>
 <h2>Sell Orders</h2>
        <table class="orders sellorders">
        <thead>
            <tr><th>OrderID</th><th>Issued</th><th>Volume Left/Entered</th><th>Minimum Volume</th><th>Price</th><th>Duration</th><th>Station Name</th><th>Region Name</th></tr>
        </thead>
        <tbody>
            {% for order in sellorders%}
            <tr><td><a href="/history/{{order.orderID}}" class="orderhistory">{{order.orderID}}</a></td><td>{{order.issued}}</td><td>{{order.volume|number_format(0, '.', ',')}}/{{order.volumeEntered|number_format(0, '.', ',')}}</td><td>{{order.minVolume|number_format(0, '.', ',')}}</td><td>{{order.price|number_format(2, '.', ',')}}</td>
            <td>{{order.duration}}</td><td><a href="/station/{{order.stationID}}/type/{{type}}/" class="typelink stationlink">{{order.stationName|escape}}</a></td><td><a href="/region/{{order.region}}/type/{{type}}/" class="typelink regionl ink">{{order.regionName}}</a></td></tr>
            {% else %}
            <tr><td>No Orders</td></tr>
            {% endfor %}
        </tbody>
        </table>
</div>
</div>
<div class="pure-g">
<div class="pure-u-1">
<a name="buy"></a>
<h2>Buy Orders</h2>
        <table class="orders buyorders">
        <thead>
            <tr><th>OrderID</th><th>Issued</th><th>Volume Left/Entered</th><th>Minimum Volume</th><th>Price</th><th>Range</th><th>Duration</th><th>Station Name</th><th>Region Name</th></tr>
        </thead>
        <tbody>
            {% for order in buyorders%}
            <tr><td><a href="/history/{{order.orderID}}" class="orderhistory">{{order.orderID}}</a></td><td>{{order.issued}}</td><td>{{order.volume|number_format(0, '.', ',')}}/{{order.volumeEntered|number_format(0, '.', ',')}}</td><td>{{order.minVolume|number_format(0, '.', ',')}}</td><td>{{order.price|number_format(2, '.', ',')}}</td><td>{{order.range}}</td>
            <td>{{order.duration}}</td><td><a href="/station/{{order.stationID}}/type/{{type}}/" class="typelink stationlink">{{order.stationName|escape}}</a></td><td><a href="/region/{{order.region}}/type/{{type}}/" class="typelink regionlink">{{order.regionName}}</a></td></tr>
            {% else %}
            <tr><td>No Orders</td></tr>
            {% endfor %}
        </tbody>
        </table>
</div>
</div>
</div>
<div class="fixedbutton">
<a href="#sell">Sell</a>|<a href="#buy">Buy</a>
</div>
{% endblock %}
