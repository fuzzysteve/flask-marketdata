{% extends "base.phtml" %}


{% block title %}Fuzzwork Market Data{% endblock %}

{% block content %}
<div class="content">
<div class="pure-g">
<div class="pure-u-1">
<h1 class="title">Fuzzwork Market Data</h1>
</div>
</div>
<div class="pure-g">
<div class="pure-u-1-1">
<p>Please select a Station and a Type to see the Orders for it</p>
</ul>
<input type=text id="stationid" placeholder="Select Station">
<input type=text id="typeid" placeholder="Select Type">
</div>
</div>
</div>
{% endblock %}
{%block footercontent %}
<script src="/js/autocomplete.js"></script>
  <script>
  var typeid = 0, stationid = 0;
  document.getElementById('typeid').value = '';
  document.getElementById('stationid').value = '';
  function go() {
    if (typeid > 0 && stationid > 0) {
      window.location="/station/"+stationid+"/type/"+typeid+"/"
    }
  }
  autocomplete(document.getElementById('typeid'), '/api/typeids', function(item) {
    typeid = item.value;
    go();
  });
  autocomplete(document.getElementById('stationid'), '/api/stationids', function(item) {
    stationid = item.value;
    go();
  });
  </script>

{% endblock %}
