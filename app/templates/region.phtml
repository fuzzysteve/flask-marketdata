{% extends "base.phtml" %}


{% block title %}Fuzzwork Market Data{% endblock %}

{% block content %}
<div class="content">
<div class="pure-g">
<div class="pure-u-1">
<h1 class="title">Fuzzwork Market Data</h1>
</div>
</div>
<div class="pure-g">
<div class="pure-u-1-1">
<p>Please select a Region and a Type to see the Orders for it</p>
</ul>
<input type=text id="regionid" placeholder="Select Region">
<input type=text id="typeid" placeholder="Select Type">
</div>
</div>
</div>
{% endblock %}
{%block footercontent %}
<script src="/js/autocomplete.js"></script>
  <script>
  var typeid = 0, regionid = 0;
  document.getElementById('typeid').value = '';
  document.getElementById('regionid').value = '';
  function go() {
    if (typeid > 0 && regionid > 0) {
      window.location="/region/"+regionid+"/type/"+typeid+"/"
    }
  }
  autocomplete(document.getElementById('typeid'), '/api/typeids', function(item) {
    typeid = item.value;
    go();
  });
  autocomplete(document.getElementById('regionid'), '/api/regionids', function(item) {
    regionid = item.value;
    go();
  });
  </script>

{% endblock %}
